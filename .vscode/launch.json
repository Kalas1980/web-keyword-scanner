{
  "version": "0.2.0",
  "configurations": [
    {
      // Press F5 to start the Flask dev server with debugger attached.
      // Breakpoints in app.py work normally.
      "name": "Run Flask app",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["run", "--port", "5001", "--debugger", "--reload"],
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development",
        "PORT": "5001"
      },
      "python": "${workspaceFolder}/.venv/bin/python",
      "jinja": true,
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      // Run the full test suite (Ctrl+Shift+D → select this config → F5)
      "name": "Run all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["test_app.py", "-v"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Run a single test file — useful when editing test_app.py
      "name": "Debug current test file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "-s"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
